{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": [],
    "paths": {
      "bso5": ["../bso5/dist/index.d.ts"],
      "bso5/jsx-runtime": ["../bso5/dist/jsx-runtime.d.ts"],
      "bso5/jsx-dev-runtime": ["../bso5/dist/jsx-runtime.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
